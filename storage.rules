rules_version = '2';

// Regras do Cloud Storage (bucket pizzariapp-90c96.firebasestorage.app).
// Storage aberto e uma das formas mais comuns de vazamento: vira
// hospedagem gratis pra terceiros e expoe qualquer arquivo enviado.

service firebase.storage {
  match /b/{bucket}/o {

    // Nega tudo por padrao.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Imagens do cardapio: leitura publica, escrita so admin.
    match /pizzas/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Foto de perfil: cada um mexe so na propria pasta.
    // Limite de 5 MB e apenas imagens, pra nao virar file host.
    match /users/{userId}/{arquivo} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
